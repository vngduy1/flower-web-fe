# Public and embedded in browser bundles at build time. Never put secrets here.
NEXT_PUBLIC_API_BASE_URL=/api

# Server-only API target. Include the NestJS global /api prefix.
BACKEND_API_BASE_URL=http://localhost:3000/api

# Optional release identifier used for rolling-deployment skew protection.
NEXT_DEPLOYMENT_ID=

# Server-side readiness timeout in milliseconds.
HEALTHCHECK_TIMEOUT_MS=3000

# Local/CI E2E only. Keep real credentials in .env.e2e.local or CI secrets.
E2E_BASE_URL=http://localhost:3001
E2E_API_BASE_URL=http://localhost:3000/api
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
